# cadence-box.yaml 模板 —— 该文件 = 密钥，勿提交勿分享（生成目录已放 .gitignore）
# 用法：改完保存 → 重启容器（docker compose -f <安装目录>\stack\compose.yaml restart devbox）即生效
git:
  name: 张三                  # 容器内 git 提交身份
  email: zhangsan@corp.com
providers:                    # 中转/官方端点均可，可多个
  relay1:
    base_url: http://your-relay.internal:9527/v1   # 兼容 claude 的中转需同时支持 anthropic 协议
    api_key: sk-xxxxxxxxxxxxxxxx                   # 泄露=盗刷，务必保密
    api: openai-completions    # 可选：openai-completions（默认）| anthropic-messages（pi/omp 用）
    wire_api: responses        # 可选：codex 协议（默认 responses；仅 chat 的中转改 chat）
    models:
      - { id: glm-5.3, ctx: 200k }
      - { id: glm-5.3-flash, ctx: 200k }
agents:                       # 各端用哪个 provider、哪个模型（pi/kimi 可省 model→取 models[0]）
  claude: { provider: relay1, model: glm-5.3 }
  codex:  { provider: relay1, model: glm-5.3 }
  pi:     { provider: relay1 }
  kimi:   { provider: relay1 }
  omp:    { provider: relay1, model: glm-5.3 }
  # 任一端可加 raw: 块，键值原样并入该端配置文件（逃生口），例：
  # claude: { provider: relay1, model: glm-5.3, raw: { theme: dark } }
