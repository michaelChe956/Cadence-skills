# devbox 构建版本 pin（ARG 唯一来源；升级只改本文件 + Dockerfile 默认值，两者保持一致）
# 2026-09-11 已验证各源存在对应产物；精确号回填纪律见 cadence/plans/2026-09-11_计划文档_实施_devbox第一期_v1.0.md Task 1
JDK_VERSION=21          # Adoptium temurin-21-jdk（USTC adoptium deb 源，noble）
MAVEN_VERSION=3.9.16    # https://mirrors.aliyun.com/apache/maven/maven-3/（原 USTC：容器内 TLS 指纹被 CF 误杀 403）
NODE_VERSION=24.21.0    # https://cdn.npmmirror.com/binaries/node/
UV_VERSION=0.12.11      # aliyun pypi（--index-url https://mirrors.aliyun.com/pypi/simple/）
PYYAML_VERSION=6.0.3    # aliyun pypi（render-auth.py 依赖）
CLAUDE_CODE_VERSION=2.1.247   # registry.npmmirror.com
CODEX_VERSION=0.153.4         # registry.npmmirror.com
PI_VERSION=0.85.0             # registry.npmmirror.com
OMP_VERSION=18.1.17          # registry.npmmirror.com @oh-my-pi/pi-coding-agent（omp CLI）
BUN_VERSION=1.4.2            # registry.npmmirror.com（omp 运行时：cli.js 她bang #!/usr/bin/env bun）
